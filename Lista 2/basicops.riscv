# Esse exercício é sobre basic logical ops
# Leia uint8_t a, b, c
# 1. Add and Subtract a and b
# 2. And, or, and xor ops with a and b
# 3. Máscara entre c e 31 = m
# 4. sll a em m bits e srl b em m bits
# Victor Cruz - 211031842

	# Directives for syscalls
	.eqv SYS_exit, 10
	.eqv SYS_print_int, 1
	.eqv SYS_print_str, 4
	.eqv SYS_print_char, 11
	.eqv SYS_read_int, 5
	
	# Setting Directives for registers
	.eqv SYS_call_reg, a7
	.eqv aptr, s11
	.eqv bptr, s10
	.eqv cptr, s9
	
	# macros
	.macro syscall (%num)
		li SYS_call_reg, %num
		ecall
	.end_macro
	
	.macro print_char (%ch)
		li a0, %ch
		syscall SYS_print_char
	.end_macro
	
	.macro print_int (%reg)
		mv a0, %reg
		syscall SYS_print_int
	.end_macro
	
	.macro print_str (%addr)
		la a0, %addr
		syscall SYS_print_str
	.end_macro
		
	
	.data
add_str: .string "ADD: "
sub_str: .string "SUB: "
and_str: .string "AND: "
or_str:  .string "OR: "
xor_str: .string "XOR: "
msk_str: .string "MASK: "
sll_str: .string "SLL("
m_addr:	 .byte 0
srl_str: .string "SRL("
lst_str: .string "): "
	
	.text
	.globl main
	
main:
	addi sp, sp, -16	# Allocating memory in the stack
	syscall SYS_read_int
	addi aptr, sp, 8
	sb a0, 0(aptr)
	syscall SYS_read_int
	addi bptr, aptr, 1
	sb a0, 0(bptr)
	syscall SYS_read_int
	addi cptr, bptr, 1
	sb a0, 0(cptr)
	
soma_sub:
	lbu s0, 0(aptr)
	lbu s1, 0(bptr)
	add t0, s0, s1	# Soma
	print_str add_str
	print_int t0
	print_char '\n'
	
	sub t0, s0, s1
	print_str sub_str
	print_int t0
	print_char '\n'
	
logical:
	and t0, s0, s1
	print_str and_str
	print_int t0
	print_char '\n'
	
	or t0, s0, s1
	print_str or_str
	print_int t0
	print_char '\n'
	
	xor t0, s0, s1
	print_str xor_str
	print_int t0
	print_char '\n'
	
mask:
	lbu s2, 0(cptr)
	andi s3, s2, 31	# s3 = m
	print_str msk_str
	print_int s3
	print_char '\n'
	la t0, m_addr
	sb s3, 0(t0)
	
shift:
	sll t0, s0, s3
	print_str sll_str 
	lb t1, m_addr	# t1 = m
	print_int t1	# Print t1
	print_str lst_str
	print_int t0	# a shifted to left
	print_char '\n'
	
	srl t0, s1, s3
	print_str srl_str 
	lb t1, m_addr
	print_int t1
	print_str lst_str
	print_int t0
	print_char  '\n'
	
	addi sp, sp, 16	# Resets the stack pointer
	
exit:
	syscall SYS_exit
	
	
	
	
	
